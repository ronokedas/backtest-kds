//@version=5
indicator("QuantumFlow: CVD DIV + FIB 0.5 + CHoCH [Fiel à Imagem]", shorttitle="QF CVD DIV FIB [Oficial]", overlay=true, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// 1. CONFIGURAÇÕES & PARÂMETROS
// ══════════════════════════════════════════════════════════════════════════════
grp_struct = "1. Estrutura de Mercado & Fibonacci"
pivLookback= input.int(5, "Sensibilidade do CHoCH (Barras)", minval=2, maxval=15, group=grp_struct, tooltip="Barras para identificar topos e fundos principais que geram o CHoCH")
fibLvl     = input.float(0.50, "Nível Fibo de Retração (0.50)", minval=0.2, maxval=0.8, step=0.05, group=grp_struct)
maxWaitRef = input.int(40, "Validade da Vela Referência (Barras)", minval=5, group=grp_struct)

grp_cvd    = "2. Cumulative Volume Delta (CVD Real Intra-Bar)"
useLowerTf = input.bool(true, "Calcular CVD Real via Candles de 1m (Binance)", group=grp_cvd, tooltip="Consulta candles de 1m na Binance para extrair delta real entre agressões")
cvdBand    = input.float(0.18, "Altura Visual do CVD no Gráfico", minval=0.05, maxval=0.4, step=0.02, group=grp_cvd)
cvdLook    = input.int(100, "Janela de Escala do CVD", minval=20, group=grp_cvd)

grp_exec   = "3. Gatilho & Gerenciamento de Risco"
triggerMode= input.string("Violação Intraday", "Modo do Gatilho", options=["Fechamento Acima", "Violação Intraday"], group=grp_exec, tooltip="Violação Intraday compra assim que a máxima da vela ref é rompida")
rrRatio    = input.float(2.0, "Relação Risco:Retorno (Alvo R:R)", step=0.5, group=grp_exec)
slBufferATR= input.float(0.15, "Folga do Stop Loss (xATR)", step=0.05, group=grp_exec)
cooldown   = input.int(6, "Cooldown entre Sinais (Barras)", minval=1, group=grp_exec)

grp_vis    = "4. Visualização & HUD"
showCvd    = input.bool(true, "Exibir Linha Amarela de CVD", group=grp_vis)
showChoch  = input.bool(true, "Exibir Linha e Rótulo de CHoCH", group=grp_vis)
showFibLn  = input.bool(true, "Exibir Linha de Fibo 50%", group=grp_vis)
showRefLn  = input.bool(true, "Exibir Linhas de Gatilho e Stop da Vela Ref", group=grp_vis)
showDiv    = input.bool(true, "Exibir Linhas de Divergência (Preço + CVD)", group=grp_vis)
showHud    = input.bool(true, "Exibir Placar & Painel Institucional", group=grp_vis)

// ══════════════════════════════════════════════════════════════════════════════
// 2. CÁLCULO DO CVD REAL (ESCOPO GLOBAL - REGRA PINE SCRIPT V5)
// ══════════════════════════════════════════════════════════════════════════════
atr14 = ta.atr(14)

[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, "1", [open, close, volume])

float barDelta = 0.0
int ltfCount = not na(ltfO) ? array.size(ltfO) : 0

if useLowerTf and ltfCount > 0
    for i = 0 to ltfCount - 1
        float o = array.get(ltfO, i)
        float c = array.get(ltfC, i)
        float v = array.get(ltfV, i)
        barDelta += (c >= o ? v : -v)
else
    rngB = high - low
    posF = rngB > 0 ? (close - low) / rngB : 0.5
    barDelta := close >= open ? volume * (0.5 + 0.5 * posF) : -volume * (0.5 + 0.5 * (1.0 - posF))

cvd = ta.cum(barDelta)

pxLo = ta.lowest(low, cvdLook)
pxHi = ta.highest(high, cvdLook)
cvdLo = ta.lowest(cvd, cvdLook)
cvdHi = ta.highest(cvd, cvdLook)
span = pxHi - pxLo

f_cvdmap(float val) =>
    float norm = cvdHi > cvdLo ? (val - cvdLo) / (cvdHi - cvdLo) : 0.5
    pxLo + norm * span * cvdBand

cvdVis = f_cvdmap(cvd)
plot(showCvd ? cvdVis : na, "CVD Institucional", color=color.new(#ffb300, 0), linewidth=2)

// ══════════════════════════════════════════════════════════════════════════════
// 3. ESTRUTURA INSTITUCIONAL (CHoCH REAL & PERNADA DE IMPULSO)
// ══════════════════════════════════════════════════════════════════════════════
pH = ta.pivothigh(high, pivLookback, pivLookback)
pL = ta.pivotlow(low, pivLookback, pivLookback)

var float lastMajorH = na
var int   lastMajorHBar = 0
var float lastMajorL = na
var int   lastMajorLBar = 0

if not na(pH)
    lastMajorH := pH
    lastMajorHBar := bar_index[pivLookback]

if not na(pL)
    lastMajorL := pL
    lastMajorLBar := bar_index[pivLookback]

var int   trendMode = 0
var float chochLvl = na
var int   chochBar = 0

chochBull = not na(lastMajorH) and close > lastMajorH and close[1] <= lastMajorH and trendMode <= 0
chochBear = not na(lastMajorL) and close < lastMajorL and close[1] >= lastMajorL and trendMode >= 0

if chochBull
    trendMode := 1
    chochLvl := lastMajorH
    chochBar := bar_index
    if showChoch
        line.new(lastMajorHBar, lastMajorH, bar_index, lastMajorH, color=color.new(color.white, 20), width=1)
        label.new(bar_index, lastMajorH, "choch", style=label.style_none, textcolor=color.white, size=size.small)

if chochBear
    trendMode := -1
    chochLvl := lastMajorL
    chochBar := bar_index
    if showChoch
        line.new(lastMajorLBar, lastMajorL, bar_index, lastMajorL, color=color.new(color.white, 20), width=1)
        label.new(bar_index, lastMajorL, "choch", style=label.style_none, textcolor=color.white, size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// 4. MAPEAMENTO DA PERNADA & NÍVEL DE FIBONACCI 50%
// ══════════════════════════════════════════════════════════════════════════════
var float legOriginLo = na
var int   legOriginLoBar = 0
var float legPeakHi = na
var int   legPeakHiBar = 0

var float legOriginHi = na
var int   legOriginHiBar = 0
var float legTroughLo = na
var int   legTroughLoBar = 0

var float fib50 = na
var line  lnFib = na
var bool  retraceActive = false

if chochBull
    legOriginLo := not na(lastMajorL) ? lastMajorL : low
    legOriginLoBar := not na(lastMajorLBar) ? lastMajorLBar : bar_index
    legPeakHi := high
    legPeakHiBar := bar_index
    fib50 := na
    retraceActive := false
    line.delete(lnFib)

if trendMode == 1 and not na(legOriginLo)
    if high > legPeakHi
        legPeakHi := high
        legPeakHiBar := bar_index
        fib50 := legPeakHi - (legPeakHi - legOriginLo) * fibLvl
        if showFibLn
            line.delete(lnFib)
            lnFib := line.new(legOriginLoBar, fib50, bar_index + 20, fib50, color=color.new(color.orange, 0), width=2)
    
    if low < legPeakHi
        retraceActive := true
        fib50 := legPeakHi - (legPeakHi - legOriginLo) * fibLvl
        if showFibLn and na(lnFib)
            lnFib := line.new(legOriginLoBar, fib50, bar_index + 20, fib50, color=color.new(color.orange, 0), width=2)
        else if showFibLn
            line.set_x2(lnFib, bar_index + 20)

if trendMode == 1 and not na(legOriginLo) and low < legOriginLo
    trendMode := 0
    retraceActive := false
    line.delete(lnFib)

if chochBear
    legOriginHi := not na(lastMajorH) ? lastMajorH : high
    legOriginHiBar := not na(lastMajorHBar) ? lastMajorHBar : bar_index
    legTroughLo := low
    legTroughLoBar := bar_index
    fib50 := na
    retraceActive := false
    line.delete(lnFib)

if trendMode == -1 and not na(legOriginHi)
    if low < legTroughLo
        legTroughLo := low
        legTroughLoBar := bar_index
        fib50 := legTroughLo + (legOriginHi - legTroughLo) * fibLvl
        if showFibLn
            line.delete(lnFib)
            lnFib := line.new(legOriginHiBar, fib50, bar_index + 20, fib50, color=color.new(color.orange, 0), width=2)
    if high > legTroughLo
        retraceActive := true
        fib50 := legTroughLo + (legOriginHi - legTroughLo) * fibLvl
        if showFibLn and na(lnFib)
            lnFib := line.new(legOriginHiBar, fib50, bar_index + 20, fib50, color=color.new(color.orange, 0), width=2)
        else if showFibLn
            line.set_x2(lnFib, bar_index + 20)

if trendMode == -1 and not na(legOriginHi) and high > legOriginHi
    trendMode := 0
    retraceActive := false
    line.delete(lnFib)

// ══════════════════════════════════════════════════════════════════════════════
// 5. DETECÇÃO ROBUSTA DA DIVERGÊNCIA NO RETESTE & VELA REFERÊNCIA
// ══════════════════════════════════════════════════════════════════════════════
var float refCandleLow = na
var float refCandleHigh = na
var int   refCandleBar = -1
var float refCandleCvd = na

var float prevDipLow = na
var float prevDipCvd = na
var int   prevDipBar = -1

var bool  divergenceBullFound = false
var int   divergenceBullBar = -1
var line  lnDivP = na
var line  lnDivC = na

var line  lnTrig = na
var line  lnStop = na

if trendMode == 1 and not na(fib50) and low <= (fib50 + atr14 * 0.25)
    if na(refCandleLow) or low < refCandleLow
        if not na(refCandleLow) and (bar_index - refCandleBar) >= 2
            prevDipLow := refCandleLow
            prevDipCvd := refCandleCvd
            prevDipBar := refCandleBar
        
        refCandleLow := low
        refCandleHigh := high
        refCandleBar := bar_index
        refCandleCvd := cvd
        
        if showRefLn
            line.delete(lnTrig)
            line.delete(lnStop)
            lnTrig := line.new(refCandleBar, refCandleHigh, bar_index + 15, refCandleHigh, color=color.white, width=2)
            lnStop := line.new(refCandleBar, refCandleLow, bar_index + 15, refCandleLow, color=color.red, width=1, style=line.style_dotted)

    if not na(prevDipLow) and refCandleLow < prevDipLow and refCandleCvd > prevDipCvd and not divergenceBullFound
        divergenceBullFound := true
        divergenceBullBar := bar_index
        if showDiv
            line.delete(lnDivP)
            line.delete(lnDivC)
            lnDivP := line.new(prevDipBar, prevDipLow, refCandleBar, refCandleLow, color=color.white, width=2)
            lnDivC := line.new(prevDipBar, f_cvdmap(prevDipCvd), refCandleBar, f_cvdmap(refCandleCvd), color=color.lime, width=2)
    
    if not divergenceBullFound and not na(refCandleLow) and (cvd > cvd[1] or barDelta > 0) and (bar_index - refCandleBar) >= 1
        divergenceBullFound := true
        divergenceBullBar := bar_index

if showRefLn and refCandleBar >= 0 and (bar_index - refCandleBar <= maxWaitRef)
    line.set_x2(lnTrig, bar_index + 10)
    line.set_x2(lnStop, bar_index + 10)

// ══════════════════════════════════════════════════════════════════════════════
// 6. GATILHO DE EXECUÇÃO EXATO & SINAIS NO GRÁFICO
// ══════════════════════════════════════════════════════════════════════════════
var int  lastTradeBar = -100
var bool tradeFiredInWave = false

if chochBull or chochBear
    tradeFiredInWave := false
    divergenceBullFound := false
    refCandleLow := na
    refCandleHigh := na
    refCandleBar := -1
    prevDipLow := na

isTriggerViolated = triggerMode == "Fechamento Acima" ? (close > refCandleHigh and close[1] <= refCandleHigh) : (high > refCandleHigh and high[1] <= refCandleHigh)

canExecuteBuy = trendMode == 1 and divergenceBullFound and not tradeFiredInWave and refCandleBar >= 0 and (bar_index > refCandleBar) and (bar_index - refCandleBar <= maxWaitRef) and (bar_index - lastTradeBar >= cooldown)

buySignal = canExecuteBuy and isTriggerViolated and barstate.isconfirmed

var float activeEntry = na
var float activeSL = na
var float activeTP = na

if buySignal
    lastTradeBar := bar_index
    tradeFiredInWave := true
    activeEntry := close
    activeSL := refCandleLow - (atr14 * slBufferATR)
    float risk = activeEntry - activeSL
    activeTP := activeEntry + (risk * rrRatio)

plotshape(buySignal, "SINAL COMPRA", shape.labelup, location.belowbar, color.new(#00e676, 0), text="COMPRA\nFIBO 0.5 + CVD", textcolor=color.black, size=size.small)
plotshape(refCandleBar >= 0 and bar_index == refCandleBar, "Vela Referência", shape.diamond, location.belowbar, color.new(color.yellow, 0), size=size.tiny)

plot(buySignal ? activeSL : na, "SL da Operação", color=color.red, linewidth=2, style=plot.style_linebr)
plot(buySignal ? activeTP : na, "TP da Operação", color=color.lime, linewidth=2, style=plot.style_linebr)

// ══════════════════════════════════════════════════════════════════════════════
// 7. SIMULAÇÃO INSTITUCIONAL & PLACAR HUD (WIN RATE / SALDO R)
// ══════════════════════════════════════════════════════════════════════════════
var int   simState = 0
var float simEntryP = na
var float simSLP = na
var float simTPP = na
var int   winCount = 0
var int   lossCount = 0
var float cumulativeR = 0.0
var int   sigCount = 0

if buySignal and simState == 0
    simState := 1
    simEntryP := close
    simSLP := activeSL
    simTPP := activeTP
    sigCount += 1

if simState == 1
    if low <= simSLP
        lossCount += 1
        cumulativeR -= 1.0
        simState := 0
    else if high >= simTPP
        winCount += 1
        cumulativeR += rrRatio
        simState := 0

var table hud = table.new(position.top_right, 2, 11, bgcolor=color.new(#0b1220, 15), border_width=1, border_color=color.new(color.gray, 60))

if showHud and barstate.islast
    int totTrades = winCount + lossCount
    float winRate = totTrades > 0 ? (100.0 * winCount / totTrades) : 0.0
    
    table.cell(hud, 0, 0, "CVD DIV FIB", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, trendMode == 1 ? (retraceActive ? "retrace ALTA" : "impulso ALTA") : trendMode == -1 ? (retraceActive ? "retrace BAIXA" : "impulso BAIXA") : "monitorando", text_color=color.yellow, text_size=size.small)
    
    table.cell(hud, 0, 1, "CHoCH", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 1, trendMode == 1 ? "▲ alta" : trendMode == -1 ? "▼ baixa" : "—", text_color=trendMode == 1 ? color.lime : trendMode == -1 ? color.red : color.silver, text_size=size.small)
    
    table.cell(hud, 0, 2, "Fibo 0.5", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 2, not na(fib50) ? "$" + str.tostring(fib50, format.mintick) : "—", text_color=color.orange, text_size=size.small)
    
    table.cell(hud, 0, 3, "Vela ref (barras)", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 3, refCandleBar >= 0 ? str.tostring(bar_index - refCandleBar) : "—", text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 4, "GATILHO ($)", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 4, refCandleBar >= 0 and not na(refCandleHigh) ? "$" + str.tostring(refCandleHigh, format.mintick) : "—", text_color=color.yellow, text_size=size.small)
    
    table.cell(hud, 0, 5, "Div CVD", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 5, divergenceBullFound ? "🟢 ALTA ATIVA" : "—", text_color=divergenceBullFound ? color.lime : color.silver, text_size=size.small)
    
    table.cell(hud, 0, 6, "CVD Bruto", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 6, str.tostring(cvd, "#,###"), text_color=#ffb300, text_size=size.small)
    
    table.cell(hud, 0, 7, "Sinais", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 7, str.tostring(sigCount), text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 8, "PLACAR W-L", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 8, str.tostring(winCount) + "W - " + str.tostring(lossCount) + "L", text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 9, "Win Rate", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 9, str.tostring(winRate, "#.1") + "%", text_color=winRate >= 50.0 ? color.lime : color.orange, text_size=size.small)
    
    table.cell(hud, 0, 10, "Saldo R", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 10, (cumulativeR >= 0 ? "+" : "") + str.tostring(cumulativeR, "#.##") + "R", text_color=cumulativeR >= 0 ? color.lime : color.red, text_size=size.small)

alertcondition(buySignal, "Compra Fibo 0.5 + CVD", "COMPRA disparada em {{ticker}} @ {{close}} | Alvo: {{plot_1}} | Stop: {{plot_0}}")
alertcondition(divergenceBullFound, "Divergência CVD Alta", "Divergência Bullish de CVD detectada em {{ticker}}")
